# Supabase Configuration (Required for app persistence)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# CyberVidya Integration (Optional overrides)
# Defaults to https://kiet.cybervidya.net (Live) and https://proxy.cybervidya.workers.dev (Proxy)
CYBERVIDYA_PORTAL_URL=https://kiet.cybervidya.net
CYBERVIDYA_PROXY_URL=https://proxy.cybervidya.workers.dev

# Admin Dashboard Security Key (Configure your secret admin key here)
ADMIN_KEY=your_secret_admin_key_here
VITE_ADMIN_KEY=your_secret_admin_key_here
